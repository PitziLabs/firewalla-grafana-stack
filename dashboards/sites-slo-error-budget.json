          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(0.001 - (1 - avg_over_time(probe_success{job=\"integrations/blackbox/lentago.dev\"}[30d]))) * 43200"
        }
      ]
    },
